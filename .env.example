# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
GEMINI_API_KEY=          # Google AI Studio; free tier quota is per project, resets midnight Pacific
ASI_API_KEY=             # Fetch.ai ASI:One (text only until it supports images)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=     # optional; defaults to a premade voice
DATABASE_URL=            # Neon connection string
CAMERA_URL=http://172.20.10.4
HUD_URL=http://172.20.10.6

# Models are provider:model (providers: gemini, openrouter, asi).
# Develop on OpenRouter (same model, no free quota used); switch PRIMARY to gemini: for the bake-off and judging.
PRIMARY_MODEL=openrouter:google/gemini-3.5-flash-lite
BACKUP_MODEL=openrouter:google/gemini-3.5-flash-lite
REASONING_EFFORT=        # optional, e.g. none or low if thinking slows the first word

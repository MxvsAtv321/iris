# Copy to .env and fill in. Never commit .env.
XAI_API_KEY=             # console.x.ai; Grok, paid from the hackathon credits
OPENROUTER_API_KEY=      # Muse Spark and the backup model
ASI_API_KEY=             # Fetch.ai ASI:One (text only until it supports images)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=     # optional; defaults to a premade voice
DATABASE_URL=            # Neon connection string
CAMERA_URL=http://172.20.10.4
HUD_URL=http://172.20.10.6
IMAGE_MAX_SIDE=1280      # px; frames bigger than this are downscaled before going to the model
IRIS_LAT=42.2780         # where live weather and sky answers are for (defaults: Ann Arbor)
IRIS_LON=-83.7382
IRIS_PLACE=Ann Arbor

# Act agent (python agent.py). Register at agentverse.ai → profile → API keys.
AGENTVERSE_KEY=          # makes the agent public on Agentverse so ASI:One can find it
AGENT_SEED_PHRASE=       # optional; stable identity. If empty, brain/.agent_seed is created and reused
AGENT_HANDLE=iris-act    # Agentverse handle, unique, max 40 characters
AGENT_PORT=8001          # the agent's own port; the brain stays on 8000
BRAIN_URL=http://127.0.0.1:8000

# Models are provider:model[@reasoning_effort] (providers: xai, openrouter, asi), e.g. xai:grok-4.7@low.
# Pick them from `python bakeoff.py` (it prints a recommendation).
PRIMARY_MODEL=xai:grok-4.20-non-reasoning   # answers questions: latency first
WATCH_MODEL=                                # judges loop frames: accuracy first; empty means PRIMARY_MODEL
BACKUP_MODEL=openrouter:google/gemini-3.5-flash-lite

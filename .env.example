# Copy to .env and fill in. Never commit .env.
XAI_API_KEY=             # console.x.ai; Grok, paid from the hackathon credits
OPENROUTER_API_KEY=      # Muse Spark and the backup model
ASI_API_KEY=             # Fetch.ai ASI:One (text only until it supports images)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=     # optional; defaults to a premade voice
DATABASE_URL=            # Neon connection string
CAMERA_URL=http://172.20.10.4
HUD_URL=http://172.20.10.6

# Models are provider:model[@reasoning_effort] (providers: xai, openrouter, asi), e.g. xai:grok-4.7@low.
# Pick them from `python bakeoff.py` (it prints a recommendation).
PRIMARY_MODEL=xai:grok-4.20-non-reasoning   # answers questions: latency first
WATCH_MODEL=                                # judges loop frames: accuracy first; empty means PRIMARY_MODEL
BACKUP_MODEL=openrouter:google/gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Memory and VR garden (Darren). Details in neon/README.md.
# ------------------------------------------------------------------------------

# The Neon memory function, origin only. From `neon functions get memory`.
MEMORY_URL=
# Shared secret for saving frames. Never sent to the browser. Generate with `openssl rand -hex 24`.
INGEST_TOKEN=
# Used by the memory function for embeddings (and the vision fallback below).
OPENAI_API_KEY=
# Optional. An endpoint that describes a JPEG, used instead of VISION_MODEL when a frame has no description.
DESCRIBE_URL=
# Only runs when a frame arrives without a description (seed and relay scripts).
VISION_MODEL=gpt-4o-mini
# How similar a frame must be to the last one to be skipped, and the floor for a search match.
DEDUPE_THRESHOLD=0.95
SEARCH_MIN_SIMILARITY=0.30
# The team tunnel's address, e.g. https://iris.example.com. Only this site may call memory
# from a browser. * allows any origin while testing.
WEB_ORIGIN=*

# Web app. Only VITE_ settings reach the browser.
VITE_MEMORY_URL=${MEMORY_URL}
# The tunnel's hostname (no https://), so the web app's server accepts requests for it.
TUNNEL_HOST=
